{
  "name": "squadpilot-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "prebuild": "node scripts/verify-historical.mjs",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test \"tests/**/*.test.ts\"",
    "test:coverage": "tsx --test --experimental-test-coverage --test-coverage-lines=85 --test-coverage-branches=80 \"tests/**/*.test.ts\"",
    "sync:historical": "node scripts/sync-vaastav.mjs",
    "verify:historical": "node scripts/verify-historical.mjs",
    "verify:reimport": "node scripts/verify-reimport.mjs",
    "train:model": "tsx scripts/train-model.mjs --gate",
    "backtest": "tsx scripts/backtest.mjs --gate"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "dependencies": {
    "@vercel/functions": "3.9.8",
    "javascript-lp-solver": "^1.0.3",
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "tailwindcss": "^4",
    "tsx": "^4.19.2",
    "typescript": "^5"
  }
}
